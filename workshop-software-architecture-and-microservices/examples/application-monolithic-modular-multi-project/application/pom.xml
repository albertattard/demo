<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>demo</groupId>
    <artifactId>application-monolithic-modular-multi-project-application</artifactId>
    <version>1.0.0</version>
    <name>Demo Application</name>
    <description>A simple application used to demonstrate different architecture styles</description>

    <properties>
        <java.version>25</java.version>
        <application-monolithic-modular-multi-project-catalogue.version>1.0.0</application-monolithic-modular-multi-project-catalogue.version>
        <application-monolithic-modular-multi-project-cart.version>1.0.0</application-monolithic-modular-multi-project-cart.version>
        <application-monolithic-modular-multi-project-db-migration.version>1.0.0</application-monolithic-modular-multi-project-db-migration.version>

        <maven.enforcer.plugin.version>3.6.2</maven.enforcer.plugin.version>
        <required.maven.version>3.6.3</required.maven.version>
    </properties>

    <dependencies>
        <!-- Catalogue -->
        <dependency>
            <groupId>demo</groupId>
            <artifactId>application-monolithic-modular-multi-project-catalogue</artifactId>
            <version>${application-monolithic-modular-multi-project-catalogue.version}</version>
        </dependency>

        <!-- Cart -->
        <dependency>
            <groupId>demo</groupId>
            <artifactId>application-monolithic-modular-multi-project-cart</artifactId>
            <version>${application-monolithic-modular-multi-project-cart.version}</version>
        </dependency>

        <!-- Database Migration -->
        <dependency>
            <groupId>demo</groupId>
            <artifactId>application-monolithic-modular-multi-project-db-migration</artifactId>
            <version>${application-monolithic-modular-multi-project-db-migration.version}</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven.enforcer.plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-versions</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>${required.maven.version}</version>
                                    <message>Maven ${required.maven.version}+ is required. Use the Maven Wrapper or upgrade your Maven installation.</message>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>${java.version}</version>
                                    <message>Java ${java.version}+ is required.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

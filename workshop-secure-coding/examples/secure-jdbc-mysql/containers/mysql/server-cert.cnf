[req]
prompt = no
distinguished_name = subject
req_extensions = request_extensions

[subject]
CN = localhost

[request_extensions]
subjectAltName = @alternative_names

[server_extensions]
basicConstraints = CA:FALSE
keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
subjectAltName = @alternative_names

[alternative_names]
DNS.1 = localhost
IP.1 = 127.0.0.1

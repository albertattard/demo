<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>demo</groupId>
    <artifactId>secure-coding-workshop</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Secure Coding Workshop</name>
    <description>
        This project is a collection of simple code examples related to the
        Secure Coding Workshop.
    </description>

    <properties>
        <java.version>25</java.version>

        <license-maven-plugin.version>2.7.1</license-maven-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <required.maven.version>3.6.3</required.maven.version>
    </properties>

    <modules>
        <module>api_validation</module>
        <module>broken-object-level-authorization</module>
        <module>client_certs</module>
        <module>construction</module>
        <module>deser_filter</module>
        <module>faulty_exception_handler</module>
        <module>input_validation</module>
        <module>jsp_auth</module>
        <module>library_ambiguity</module>
        <module>limit_check_overflow</module>
        <module>mitm_http</module>
        <module>module_isolation</module>
        <module>mutable_static</module>
        <module>mysql_encryption</module>
        <module>obfuscated_code</module>
        <module>owasp_dependency_check</module>
        <module>owasp_java_encoder</module>
        <module>reflection_mutability</module>
        <module>return_values</module>
        <module>sanitizing_log_output</module>
        <module>secure_jdbc_mysql</module>
        <module>serialization_leak</module>
        <module>sql_injection</module>
        <module>token_bucket</module>
        <module>try_with_resources</module>
        <module>url_data_leak</module>
        <module>xml_parsing_attack</module>
    </modules>

    <build>
        <defaultGoal>clean package</defaultGoal>

        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>${license-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>aggregate-third-party</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>aggregate-add-third-party</goal>
                        </goals>
                        <configuration>
                            <failOnMissing>true</failOnMissing>
                            <failOnBlacklist>false</failOnBlacklist>
                            <excludedScopes>test</excludedScopes>
                            <includedLicenses>
                                <!-- Apache 2 -->
                                <includedLicense>Apache License, Version 2.0</includedLicense>
                                <includedLicense>The Apache Software License, Version 2.0</includedLicense>
                                <includedLicense>The Apache License, Version 2.0</includedLicense>
                                <includedLicense>Apache 2.0</includedLicense>
                                <includedLicense>Apache License 2.0</includedLicense>
                                <includedLicense>Apache License Version 2.0</includedLicense>
                                <includedLicense>Apache-2.0</includedLicense>
                                <!-- MIT -->
                                <includedLicense>MIT</includedLicense>
                                <includedLicense>MIT License</includedLicense>
                                <includedLicense>The MIT License</includedLicense>
                                <!-- BSD-3-Clause and its Eclipse Distribution License aliases -->
                                <includedLicense>BSD-3-Clause</includedLicense>
                                <includedLicense>EDL 1.0</includedLicense>
                                <includedLicense>Eclipse Distribution License - v 1.0</includedLicense>
                                <includedLicense>Eclipse Distribution License v. 1.0</includedLicense>
                            </includedLicenses>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-versions</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>${required.maven.version}</version>
                                    <message>Maven ${required.maven.version}+ is required. Use the Maven Wrapper or upgrade your Maven installation.</message>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[${java.version},)</version>
                                    <message>Java ${java.version}+ is required.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
